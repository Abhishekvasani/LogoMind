# LogoMind Backend Environment
# Copy to .env and adjust as needed

# Database (SQLite for dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./logomind.db

# AI Provider configuration
# Provider selection: mock | openai | openrouter
LOGOMIND_AI_PROVIDER=mock

# OpenAI (uncomment and set key to use real AI)
# OPENAI_API_KEY=sk-...
# LOGOMIND_MODEL=gpt-4o

# OpenRouter — free/open models via an OpenAI-compatible API.
# Get a key at https://openrouter.ai/keys, then:
#   LOGOMIND_AI_PROVIDER=openrouter
#   OPENAI_API_KEY=sk-or-...
# LOGOMIND_MODEL defaults to a free model; override to pick another, e.g.:
#   LOGOMIND_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: any OpenAI-compatible base URL overrides the endpoint:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1

# CORS — frontend origin
CORS_ORIGINS=http://localhost:3000

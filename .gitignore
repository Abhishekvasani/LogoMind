# =====================================================================
# LogoMind .gitignore
# =====================================================================
# LogoMind is primarily a knowledge repository (Markdown, diagrams).
# This .gitignore excludes OS/editor cruft and reserves space for
# future software build artifacts without committing them.
# =====================================================================

# --- OS-generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editor / IDE temp files ---
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# --- ZCode / agent working files ---
.zcode/

# --- Temporary / scratch ---
*.tmp
*.bak
*.log
tmp/
temp/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/
*.db
*.sqlite
*.sqlite3

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
dist/
.cache/
.vercel/
*.tsbuildinfo

# --- Environment files ---
.env
.env.local
.env.*.local

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Keep these (do NOT ignore) ---
!.gitignore
!.gitattributes
!.env.example

# --- Future: uploads / user-generated content ---
uploads/
media/

# --- Keep these (do NOT ignore) ---
!.gitignore
!.gitattributes
